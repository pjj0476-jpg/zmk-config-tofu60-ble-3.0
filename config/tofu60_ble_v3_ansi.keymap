#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include "boards/shields/klink_kbd/common.keymap"

#define UF_RESET bootloader_reset 0 0
#define UF_BT1 device_bt1 0 0
#define UF_BT2 device_bt2 0 1
#define UF_BT3 device_bt3 0 2

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC                 &kp N1    &kp N2    &kp N3       &kp N4  &kp N5    &kp N6    &kp N7     &kp N8  &kp N9     &kp N0    &kp MINUS  &kp EQUAL   &kp BSLH       &kp DELETE
&kp TAB                 &kp Q     &kp W     &kp E        &kp R   &kp T     &kp Y     &kp U      &kp I   &kp O      &kp P     &kp LBKT   &kp RBKT    &kp BACKSPACE
&mt LEFT_CONTROL LANG1  &kp A     &kp S     &kp D        &kp F   &kp G     &kp H     &kp J      &kp K   &kp L      &kp SEMI  &kp SQT    &kp RET
&kp LSHFT               &kp NUBS  &kp Z     &kp X        &kp C   &kp V     &kp B     &kp N      &kp M   &kp COMMA  &kp DOT   &kp FSLH   &kp RSHIFT  &mo 1
&kp LEFT_CONTROL        &kp LGUI  &kp LALT  &lt 1 SPACE  &mo 1   &kp RALT  &kp RGUI  &kp RCTRL
            >;
        };

        layer1 {
            bindings = <
&trans     &kp F1    &kp F2    &kp F3     &kp F4         &kp F5  &kp F6  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp ASTERISK  &trans  &trans  &trans  &trans
&kp MINUS  &kp HOME  &kp UP    &kp END    &kp PAGE_UP    &trans  &trans  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &trans        &trans  &trans  &trans
&trans     &kp LEFT  &kp DOWN  &kp RIGHT  &kp PAGE_DOWN  &trans  &trans  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &trans        &trans  &trans
&trans     &trans    &kp PLUS  &trans     &trans         &trans  &trans  &trans           &kp KP_NUMBER_0  &trans           &trans        &trans  &trans  &trans
&trans     &trans    &trans    &trans     &trans         &trans  &trans  &trans
            >;
        };

        layer2 { status = "reserved"; };

        layer3 { status = "reserved"; };

        layer4 { status = "reserved"; };

        layer5 { status = "reserved"; };

        layer6 { status = "reserved"; };

        layer7 { status = "reserved"; };
    };
};
